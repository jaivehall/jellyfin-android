<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">
    <!-- Finplayer snowflake: three rotated F glyphs, scaled down by 1/3 vs v5 -->

    <!-- F 1: cool blue -->
    <group android:rotation="0" android:pivotX="512" android:pivotY="512">
        <path
            android:pathData="M512,512L512,360M512,360L618.667,360M512,437.333L581.333,437.333"
            android:fillColor="@android:color/transparent"
            android:strokeWidth="29.333"
            android:strokeLineCap="round"
            android:strokeLineJoin="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="radial"
                    android:centerX="512" android:centerY="512"
                    android:gradientRadius="200"
                    android:startColor="#7CE7FF"
                    android:endColor="#3C7BFF" />
            </aapt:attr>
        </path>
    </group>

    <!-- F 2: mint green -->
    <group android:rotation="120" android:pivotX="512" android:pivotY="512">
        <path
            android:pathData="M512,512L512,360M512,360L618.667,360M512,437.333L581.333,437.333"
            android:fillColor="@android:color/transparent"
            android:strokeWidth="29.333"
            android:strokeLineCap="round"
            android:strokeLineJoin="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="radial"
                    android:centerX="512" android:centerY="512"
                    android:gradientRadius="200"
                    android:startColor="#9BF6D8"
                    android:endColor="#2ED3B5" />
            </aapt:attr>
        </path>
    </group>

    <!-- F 3: warm coral -->
    <group android:rotation="240" android:pivotX="512" android:pivotY="512">
        <path
            android:pathData="M512,512L512,360M512,360L618.667,360M512,437.333L581.333,437.333"
            android:fillColor="@android:color/transparent"
            android:strokeWidth="29.333"
            android:strokeLineCap="round"
            android:strokeLineJoin="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="radial"
                    android:centerX="512" android:centerY="512"
                    android:gradientRadius="200"
                    android:startColor="#FFC08A"
                    android:endColor="#FF6F91" />
            </aapt:attr>
        </path>
    </group>
</vector>
