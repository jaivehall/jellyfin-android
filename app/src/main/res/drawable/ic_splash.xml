                <gradient android:type="radial" android:centerX="512" android:centerY="512"
                    android:gradientRadius="450" android:startColor="#9BF6D8" android:endColor="#2ED3B5" />
            </aapt:attr>
        </path>
    </group>
    <group android:rotation="240" android:pivotX="512" android:pivotY="512">
