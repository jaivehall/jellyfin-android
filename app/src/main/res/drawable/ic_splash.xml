    <group android:rotation="0" android:pivotX="512" android:pivotY="512">
        <path
            android:pathData="M512,512L512,170M512,170L752,170M512,341L668,341"
            android:fillColor="@android:color/transparent"
            android:strokeWidth="66"
            android:strokeLineCap="round"
            android:strokeLineJoin="round">
            <aapt:attr name="android:strokeColor">
                <gradient android:type="radial" android:centerX="512" android:centerY="512"
                    android:gradientRadius="450" android:startColor="#7CE7FF" android:endColor="#3C7BFF" />
            </aapt:attr>
        </path>
    </group>
    <group android:rotation="120" android:pivotX="512" android:pivotY="512">
        <path
            android:pathData="M512,512L512,170M512,170L752,170M512,341L668,341"
            android:fillColor="@android:color/transparent"
            android:strokeWidth="66"
            android:strokeLineCap="round"
            android:strokeLineJoin="round">
